{
  "name": "boardtestify",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @boardtestify/api\" \"npm run dev -w @boardtestify/web\"",
    "build": "npm run build -w @boardtestify/web",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/*.integration.js",
    "seed": "npm run seed -w @boardtestify/api",
    "admin": "npm run admin -w @boardtestify/api",
    "check": "node scripts/check.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.4",
    "expo-font": "~55.0.8"
  }
}
