NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/boardtestify
JWT_SECRET=replace-with-at-least-48-random-characters-before-running
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
# Optional integrations; blank values keep the corresponding feature disabled.
# Get a Gemini API key at https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
SMTP_URL=
MAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PASS_PRICE_PAISE=9900
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Reliability / scaling. Run API replicas with RUN_WORKER=false and a separate worker.
DB_POOL_MAX=30
DB_SELECTION_TIMEOUT_MS=30000
# Keep production queues short; local slow Atlas connections can use 30000.
DB_WAIT_QUEUE_TIMEOUT_MS=5000
API_CONCURRENCY=150
WORKER_CONCURRENCY=2
RUN_WORKER=true
TRUST_PROXY_HOPS=0
# Set to true only for a model supporting image inputs. Handwriting still needs teacher review.
AI_VISION_ENABLED=true
# Google Cloud Vision API key, restricted to the Vision API and server egress where possible.
OCR_API_KEY=
# Twilio Verify credentials; linking a verified phone enables OTP sign-in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
ATTACHMENT_RETENTION_DAYS=90

# Optional: use 4 when the IPv4 connection test succeeds on your local network.
# DB_IP_FAMILY=4
