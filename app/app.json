{
  "expo": {
    "name": "BoardTestify",
    "slug": "boardtestify",
    "scheme": "boardtestify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "in.boardtestify.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BoardTestify to upload answer-sheet photos.",
          "cameraPermission": "Allow BoardTestify to photograph handwritten answer pages.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
